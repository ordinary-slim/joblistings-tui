ScrapeScreen {
    align: center middle;
    background: $background 60%;
}

#scrape-dialog {
    width: 80%;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

#scrape-queries {
    height: 1fr;
    margin-bottom: 1;
}

#scrape-actions {
    height: auto;
    align: right middle;
    padding: 1;
}

JobDetailScreen {
    align: center middle;
    background: $background 40%;
}

#job-detail-content {
    width: 90%;
    height: 90%;
    padding: 1 2;
    height: 1fr;
    margin-bottom: 1;
    border: round $primary;
    background: $surface;
}
#job-actions {
    width: 90%;
    /* height: 90%; */
    /* padding: 1 2; */
    /* height: 1fr; */
    /* margin-bottom: 1; */
    /* border: round $primary; */
    /* background: $surface; */
}

#job-details-interest-score-label {
    /* color: $accent; */
    /* width: 10; */
    height: 3;
    margin-bottom: 1;
    /* top right bottom left */
    padding: 1 1 1 2;
    text-style: italic;
}

#job-details-interest-score {
    color: $accent;
    width: 10;
    height: 3;
    margin-bottom: 1;
    padding: 1 0 1 1;
}
